{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Jupyter Notebook Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "JUPYTER_PATH": "/Users/zachshallbetter/Library/Jupyter",
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--notebook-dir=${workspaceFolder}/Sites/llm-fine-tuner",
                "--ip='localhost'",
                "--port=8888",
                "--no-browser"
            ]
        }
    ]
}